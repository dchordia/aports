pkgrel=0
pkgdesc="eProsima Fast DDS with bundled foonathan"
url="https://github.com/eProsima/Fast-DDS"
arch="all"
license="Apache-2.0"
pkgname=fastdds
pkgver=2.14.4
pkgrel=1

makedepends="
    build-base
    cmake
    ninja
    fast-cdr-dev
    foonathan-memory
    foonathan-memory-vendor
    asio-dev
    openssl-dev
    qnx-fs-notify-dev
    tinyxml2
    asio
    qnx-fs-core-dev
    gtest-dev
"   

# prepare() {
#     default_prepare
#     cd "$srcdir/Fast-DDS-$pkgver"
#     patch -p1 < "$srcdir/0001-qnx-platform-adjustments.patch"
# }
source="
    fastdds-$pkgver.tar.gz::https://github.com/eProsima/Fast-DDS/archive/refs/tags/v$pkgver.tar.gz
    qnx.patch
"

builddir="$srcdir/Fast-DDS-$pkgver"

build() {
    cd "$builddir"

    cmake -B build \
        -S "$builddir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=ON \
        -DQNX=TRUE \
        -DFASTDDS_USE_FILE_WATCH=OFF \
        -DFASTDDS_PERSISTENCE=OFF \
        -DEPROSIMA_BUILD_TESTS=ON \
        -DSECURITY=OFF

    cmake --build build
}

check() {
    cd "$builddir/build"
    ctest --output-on-failure -j$(nproc)
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

