pkgname=epoll
pkgver=1.0.0
pkgrel=0
branch=main
pkgdesc="epoll is a high-performance QNX polling API"
arch="all"
license="MIT"
url="https://github.com/qnx-ports/epoll"
makedepends="cmake"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/epoll/archive/refs/heads/main.tar.gz"
builddir="$srcdir/$pkgname-$branch"

build() {
  make
}

package() {
  DESTDIR="$pkgdir" make install
}

