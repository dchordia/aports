 int
 flushdisk(int fd)
 {
+#ifdef linux
 	int	ret = ioctl(fd, BLKFLSBUF, 0);
 	usleep(100000);
 	return (ret);
+#elif defined(__QNX__)
+	pgcache_ctl_t ctl;
+	int ret;
+
+	memset(&ctl, 0, sizeof(ctl));
+	ctl.op = DCMD_FSYS_PGCACHE_CTL_OP_DISCARD;
+
+	ret = devctl(fd, DCMD_FSYS_PGCACHE_CTL, &ctl, sizeof(ctl), NULL);
+	usleep(100000);
+
+	if (ret != EOK) {
+		errno = ret;
+		return -1;
+	}
+
+	return 0;
+#endif
 }
 
 #endif
