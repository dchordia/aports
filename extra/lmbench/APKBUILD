e244349d0c33af4c776ce1dd4e752a38ba5da30e3bbf4b536d9f2cdea5e61d7a1ec10b8db28c21b2eae41b981d36f760790060ff4a85b9968bbad9951f796fd2  0001-add-qnx-build.patch
"
