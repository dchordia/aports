# Maintainer: Harshini Yarasi <hyarasi@qnx.com>
pkgname=boringssl

_tag="0.20260327.0"
pkgver="${_tag}"
pkgrel=0
pkgdesc="BoringSSL cryptographic library"
url="https://boringssl.googlesource.com/boringssl"
arch="all"
license="Apache-2.0"

makedepends="cmake ninja perl"
depends="
libc++
qnx-gcc-libs
qnx-io-sock
qnx-microkernel
"
subpackages="$pkgname-dev"

source="$pkgname-${_tag}.tar.gz::https://boringssl.googlesource.com/boringssl/+archive/refs/tags/${_tag}.tar.gz
qnx-getentropy.patch
qnx-benchmark.patch"

builddir="$srcdir"

prepare() {
	 default_prepare
}

build(){
    cmake -GNinja -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_C_FLAGS="-Wno-error " \
        -DCMAKE_CXX_FLAGS="-Wno-error " \
        -DCMAKE_EXE_LINKER_FLAGS="-lsocket"  
      
    ninja -C build  
}

check()
{
	build
}

package(){
	DESTDIR="$pkgdir" ninja -C build install
}
