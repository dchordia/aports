[qnxuser@qnxpi ~/aports/extra/rtl-sdr]$ cat /usr/lib/pkgconfig/libusb-1.0.pc
prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libusb-1.0
Description: C API for USB device access from Linux, Mac OS X, Windows, OpenBSD/NetBSD and Solaris userspace
Version: 1.0.23
Libs: -L${libdir} -lusb-1.0
Libs.private: -lusbdi -lpci
Cflags: -I${includedir}/libusb-1.0
[qnxuser@qnxpi ~/aports/extra/rtl-sdr]$ 
[qnxuser@qnxpi ~/aports/extra/rtl-sdr]$ 
[qnxuser@qnxpi ~/aports/extra/rtl-sdr]$ cat APKBUILD
pkgname=rtl-sdr
pkgver=2.0.2
pkgrel=0
pkgdesc="Software defined radio receiver for Realtek RTL2832U"
url="https://github.com/qnx-ports/rtl-sdr"
arch="all"
license="GPL-2.0-or-later"

makedepends="
    cmake
    ninja
    pkgconf
    libusb-dev
"

depends="libc++ libusb"

source="$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/rtl-sdr/archive/refs/heads/qnx_2.0.2.tar.gz"

builddir="$srcdir/rtl-sdr-qnx_2.0.2"

build() {
    cd "$builddir"

    export PKG_CONFIG_PATH="/usr/lib/pkgconfig:/usr/share/pkgconfig"
    unset PKG_CONFIG_LIBDIR
    unset PKG_CONFIG_SYSROOT_DIR
    export LDFLAGS="-L/usr/lib"
    export LIBS="-lusbdi -lpci"
    cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DCMAKE_FIND_LIBRARY_SUFFIXES=".so" \
        -DLIBUSB_LIBRARIES=/usr/lib/libusb-1.0.so.0 \
        -DLIBUSB_INCLUDE_DIR=/usr/include/libusb-1.0

    cmake --build build
}


package() {
    DESTDIR="$pkgdir" cmake --install build
}
