bbf139de43dee54ee80cda8825faafddac5c6b45c616c7b5ddb909dd490176dccced5d0410066dd5daf87bc9ef32c1b9cd9cb9e9fa17e372b79ecb354f83e097  0006-add-qnx-build.patch
"
