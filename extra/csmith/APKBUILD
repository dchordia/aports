f1df644b4bb204bd550606ec064dc325b7aab7cdb38c3932d1a26cd16dc221a2ecc1d26b04e19db7da5b08fd9ac685b878a56f4161fa56767b0aed96168a99d0  add_qnx_support.patch
"
