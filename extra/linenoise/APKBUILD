# Maintainer: Ramya santoshi <rtimmaraju@qnx.com>

pkgname=linenoise
pkgver=2.0
pkgrel=0
pkgdesc="Small, portable readline replacement"
url="https://github.com/antirez/linenoise"
arch="all"
license="BSD-2-Clause"

source="$pkgname-$pkgver.tar.gz::https://github.com/antirez/linenoise/archive/refs/tags/$pkgver.tar.gz"

builddir="$srcdir/$pkgname-$pkgver"

options="!check"

subpackages="$pkgname-dev"

build() {
	cd "$builddir"

	# Build the shared library
	${CC:-cc} ${CFLAGS} -fPIC -c linenoise.c -o linenoise.o

	${CC:-cc} ${LDFLAGS} \
		-shared \
		-Wl,-soname,liblinenoise.so.1 \
		-o liblinenoise.so.1.0.0 \
		linenoise.o

	ln -sf liblinenoise.so.1.0.0 liblinenoise.so.1
	ln -sf liblinenoise.so.1 liblinenoise.so

	# Build the example application
	${CC:-cc} ${CFLAGS} \
		-o linenoise_example  \
		linenoise.c example.c
}

package() {
	cd "$builddir"

	install -Dm755 liblinenoise.so.1.0.0 \
		"$pkgdir"/usr/lib/liblinenoise.so.1.0.0

	ln -sf liblinenoise.so.1.0.0 \
		"$pkgdir"/usr/lib/liblinenoise.so.1

	ln -sf liblinenoise.so.1 \
		"$pkgdir"/usr/lib/liblinenoise.so

	install -Dm644 linenoise.h \
		"$pkgdir"/usr/include/linenoise.h
    
    install -Dm755 linenoise_example \
    "$pkgdir"/usr/bin/linenoise_example
}

sha512sums="
9e68fade8d64d7ba8d5d681e74d0ca6c4ebd9576249bb0e885b1aa708a9af77a43ea6264307ae46fb74e52219387a2c831b570f9601e331837f35294af9883e3  linenoise-1.0.tar.gz
"