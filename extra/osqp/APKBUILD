# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=osqp
pkgver=0.6.3
pkgrel=0
pkgdesc="Optimization solver for Quadratic Programs (QPs)"
url="https://github.com/osqp/osqp"
arch="aarch64 x86_64"
license="Apache-2.0"
options="!check" # Cannot build tests
source="$pkgname-$pkgver.tar.gz::https://github.com/osqp/osqp/releases/download/v$pkgver/osqp-v$pkgver-src.tar.gz"
builddir="$srcdir"
depends="libc++"
makedepends="
	libc++-dev
	cmake
	ninja
"
subpackages="$pkgname-dev"

build() {
	cmake3.5 -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DUNITTESTS=OFF
	cmake3.5 --build build
}

check() {
	ctest3.5 --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake3.5 --install build
}

sha512sums="
3176e87d71731d523d16706a404f087c7dd076a74b6dab6172e568ae4d945cb81591ce88aaad53926762c342f2981b8269c7fa1a0b9528675d3823fb2b996fb7  osqp-0.6.3.tar.gz
"
