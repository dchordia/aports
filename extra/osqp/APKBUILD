8e826fc7e068b2ea94d4da2ae6035eb29ef14d4cf82eff2a9c4879aaaaeed957d63e1cc48ab652f24770d63e1541b14ca76c61b1a28298119f4a9289a10e4d7e  scipy-test-fix.patch
"
