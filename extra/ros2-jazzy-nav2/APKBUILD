prepare() {
        cd "$builddir"
        _apply_qnx_patch() {
                local _dir="$1"
                local _patch="$2"
                git -C "$builddir/$_dir" apply --whitespace=nowarn "$srcdir/$_patch"
        }
        _apply_qnx_patch slam_toolbox-2.8.4 slam_toolbox.patch
        _apply_qnx_patch BehaviorTree.CPP-4.9.0 behaviortree_cpp.patch
        _apply_qnx_patch navigation2-1.3.11 navigation2.patch
}

build() {
        cd "$builddir"
        export CXXFLAGS="${CXXFLAGS//-fstack-clash-protection/}"
        export CFLAGS="${CFLAGS//-fstack-clash-protection/}"
	source /opt/ros/jazzy/setup.bash
        colcon build --merge-install \
                --cmake-args \
                        -G Ninja \
                        -DBUILD_TESTING=OFF \
                        -DCMAKE_BUILD_TYPE=Release \
			-DCMAKE_C_FLAGS="$CFLAGS -fvisibility=default -frtti -DSA_RESTART=0 -Wno-error=old-style-cast -Wno-error=inconsistent-missing-override -Wno-error=overloaded-virtual -Wno-error=ignored-optimization-argument -Wno-error=unknown-warning-option -Wno-error=pessimizing-move -Wno-error=braced-scalar-init" \
			-DCMAKE_CXX_FLAGS="$CXXFLAGS -fvisibility=default -frtti -DSA_RESTART=0 -Wno-error=old-style-cast -Wno-error=inconsistent-missing-override -Wno-error=overloaded-virtual -Wno-error=ignored-optimization-argument -Wno-error=unknown-warning-option -Wno-error=pessimizing-move -Wno-error=braced-scalar-init" \
                        -DCMAKE_EXE_LINKER_FLAGS="-lsocket -lfsnotify -lc++ -lc++abi -Wl,-E" \
                        -DCMAKE_SHARED_LINKER_FLAGS="-lsocket -lfsnotify -lc++ -lc++abi -Wl,-E" \
                        -DTRACETOOLS_TRACEPOINTS_EXCLUDED=ON \
                        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
                --packages-skip nav2_rviz_plugins
}

package() {
        dest="/opt/ros/jazzy"
        mkdir -p "$pkgdir"/$dest
        cp -a "$builddir"/install/. "$pkgdir"/$dest

        # Remove files we don't want in our final package
        for _f in  COLCON_IGNORE .colcon_install_layout _local_setup_util_ps1.py local_setup.ps1 setup.ps1 _local_setup_util_sh.py local_setup.bash local_setup.bash local_setup.sh local_setup.zsh setup.bash setup.sh setup.zsh; do
            [[ -f "$pkgdir"/$dest/$_f ]] && rm "$pkgdir"/$dest/$_f
        done
}

