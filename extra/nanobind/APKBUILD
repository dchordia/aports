# Maintainer: Deep Chordia <dchordia@blackberry.com>
pkgname=nanobind
pkgver=2.10.2
pkgrel=0
pkgdesc="tiny and efficient C++/Python bindings"
url="https://github.com/wjakob/nanobind"
arch="all"
license="BSD-3-Clause"
_depname=robin-map
_depver=4ec1bf19c6a96125ea22062f38c2cf5b958e448e
depends_dev="python3-dev"
depends="python3"
makedepends="
    $depends_dev
    cmake
    ninja
"
subpackages="$pkgname-dev"
checkdepends="python3-pytest"
source="
    $pkgname-$pkgver.tar.gz::https://github.com/wjakob/nanobind/archive/refs/tags/v$pkgver.tar.gz
    $_depname-$_depver.tar.gz::https://github.com/Tessil/robin-map/archive/$_depver.tar.gz
    0001-add-qnx-build.patch
"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
  mv "$srcdir"/$_depname-$_depver/* "$builddir"/ext/robin_map
  default_prepare
}

build() {
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DNB_TEST_SHARED_BUILD=ON \
    -DNB_TEST_FREE_THREADED=OFF
  cmake --build build
}

check() {
  _test_exclude="test04_subinterpreters"
  pytest build/tests -k "not $_test_exclude"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}

