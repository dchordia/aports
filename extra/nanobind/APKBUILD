d1e5baf70b3100f0dea3c7004689a0ed5ee627fee83ada0b5d726b97336822b878f8802e2276637e61e40a72b2f7b3e470ec2d10e3f28baf572a3518c85d62eb  robin-map-4ec1bf19c6a96125ea22062f38c2cf5b958e448e.tar.gz
5556727bc2cbca21605b7a2ed91777310e09ab532a855c1688e49452832b4a925df7fe7a96b7e560d3b58d3dd82f32b87013c228202fa08ee50a7300d232eb68  0001-add-qnx-build.patch
"
