From e66d4fd03a4dab52badc6e4023325bd4c8b319f5 Mon Sep 17 00:00:00 2001
From: felixlionardo <flionardo@blackberry.com>
Date: Thu, 19 Feb 2026 13:54:31 -0500
Subject: [PATCH] qnx-scroll-fix

---
 qnx/build/backends/qnx-screen/qnx-screen.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/qnx/build/backends/qnx-screen/qnx-screen.c b/qnx/build/backends/qnx-screen/qnx-screen.c
index 8e3228f1..e5f9568d 100644
--- a/qnx/build/backends/qnx-screen/qnx-screen.c
+++ b/qnx/build/backends/qnx-screen/qnx-screen.c
@@ -34,6 +34,7 @@
 #include <unistd.h>
 #include <errno.h>
 #include <sys/time.h>
+#include <sys/utsname.h>
 #include <linux/input.h>
 #define INPUT_KEY_DOWN HIDD_USAGE_KEYBOARD_ARROW_DOWN
 #undef KEY_DOWN
@@ -104,6 +105,7 @@ struct qnx_screen_backend {
 
 	const struct pixel_format_info **formats;
 	unsigned int formats_count;
+	int invert_scroll;
 };
 
 struct qnx_screen_head {
@@ -1017,7 +1019,12 @@ qnx_screen_backend_deliver_scroll_event(struct qnx_screen_backend *b,
 	struct weston_pointer_axis_event weston_event;
 
 	weston_event.axis = WL_POINTER_AXIS_VERTICAL_SCROLL;
-	weston_event.value = -(scroll_delta);
+	if (b->invert_scroll) {
+		weston_event.value = (scroll_delta);
+	}
+	else {
+		weston_event.value = -(scroll_delta);
+	}
 	weston_event.has_discrete = false;
 	weston_compositor_get_time(&time);
 
@@ -1440,6 +1447,16 @@ qnx_screen_backend_create(struct weston_compositor *compositor,
 		goto err_event_monitor;
 	}
 
+	struct utsname uname_data;
+	b->invert_scroll = 0;
+	if (uname(&uname_data) == 0) {
+		if (strstr(uname_data.machine, "RaspberryPi") != NULL) {
+			b->invert_scroll = 1;
+		}
+	} else {
+		perror("uname");
+	}
+
 	return b;
 
 err_event_monitor:
-- 
2.52.0

