# Maintainer: Deep Chordia <dchordia@blackberry.com>
pkgname=pytorch
pkgver=2.12.1
pkgrel=0
pkgdesc="Tensors and Dynamic neural networks in Python with strong GPU acceleration"
url="https://pytorch.org/"
arch="all"
license="BSD-3-Clause"
_python3_depends="
    python3
    python3-numpy
    python3-pybind11
    python3-protobuf
    python3-filelock
    python3-jinja2
    python3-typing-extensions
"
depends="
    libc++
    cpuinfo
    pthreadpool
    protobuf
    gflags
    openblas
    onnx
    $_python3_depends
    "
depends_dev="
    libc++-dev
    cpuinfo-dev
    pthreadpool-dev
    protobuf-dev
    gflags-dev
    openblas-dev
    onnx-dev
    python3-dev
    python3-numpy-dev
    python3-pybind11-dev
    "
makedepends="
    $depends_dev
    cmake
    ninja
    python3-yaml
    python3-six
    python3-gpep517
    benchmark-dev
    "
subpackages="
    $pkgname-dev
    "
options="!check"
source="
    $pkgname-$pkgver.tar.gz::https://github.com/pytorch/pytorch/releases/download/v$pkgver/pytorch-v$pkgver.tar.gz
    0001-XNNPACK-qnx-build_patch
    0002-kineto-qnx-build_patch
    0003-add-qnx-build.patch
"
builddir="$srcdir/$pkgname-v$pkgver"

prepare() {
    default_prepare
    (cd $builddir/third_party/XNNPACK && patch ${patch_args:--p1} -i "$srcdir"/0001-XNNPACK-qnx-build_patch)
    (cd $builddir/third_party/kineto && patch ${patch_args:--p1} -i "$srcdir"/0002-kineto-qnx-build_patch)
}

build() {
    export CXXFLAGS="$CXXFLAGS \
        -Wno-error=unused-command-line-argument -Wno-unused-command-line-argument \
        -Wno-error=nontrivial-memcall -Wno-nontrivial-memcall \
        -Wno-error=vla-cxx-extension -Wno-vla-cxx-extension \
        -Wno-error=character-conversion -Wno-character-conversion\
        -Wno-error=missing-field-initializers -Wno-missing-field-initializers\
        -Wno-error=thread-safety-analysis -Wno-thread-safety-analysis\
        -Wno-error=unknown-warning-option \
        -DEIGEN_DONT_VECTORIZE"

    export CMAKE_BUILD_TYPE=Release
    export CMAKE_POLICY_VERSION_MINIMUM=3.5
    export CMAKE_SYSTEM_NAME=QNX
    export USE_ROCM=OFF
    export USE_CUDA=OFF
    export USE_MAGMA=OFF
    export USE_XPU=OFF
    export USE_ITT=OFF
    export USE_NNPACK=OFF
    export BUILD_CUSTOM_PROTOBUF=OFF
    export USE_DISTRIBUTED=OFF
    export USE_MKLDNN=OFF
    export USE_NNPACK=OFF
    export USE_QNNPACK=OFF
    export USE_SYSTEM_XNNPACK=OFF
    export USE_SYSTEM_ONNX=ON
    export USE_SYSTEM_PYBIND11=ON
    export USE_GFLAGS=ON
    export USE_BLAS=ON
    export USE_SYSTEM_CPUINFO=ON
    export USE_SYSTEM_PTHREADPOOL=ON
    export USE_SYSTEM_BENCHMARK=ON
    export BUILD_MOBILE_TEST=OFF
    export BUILD_BINARY=OFF
    export TRACING_BASED=OFF
    export BUILD_PYTHON=ON
    export BUILD_TEST=ON
    export CMAKE_LINK_LIBRARY_USING_WHOLE_ARCHIVE_SUPPORTED=TRUE

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    # Core math engine (pure C++) tests
    _test_exclude="vec_test_all_types_DEFAULT|vec_test_all_types_AVX512|vec_test_all_types_AVX2|StorageUtils_test|inline_container_test"
    ctest --test-dir build -E $_test_exclude -j1

    # Python bindings communication and usage with C++ internals tests
    python3 -m venv --clear --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl
    .testenv/bin/python3 -m pip install "hypothesis<6.80.0"
    .testenv/bin/python3 -m pip install expecttest pytest-rerunfailures pytest-flakefinder pytest-xdist sympy fsspec
    PYTORCH_NUM_PYTEST_RERUNS=0 .testenv/bin/python3 test/run_test.py --keep-going
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

