# Maintainer: Deep Chordia <dchordia@blackberry.com>
pkgname=fast-cdr
pkgver=2.3.5
pkgrel=0
pkgdesc="eProsima FastCDR library provides two serialization mechanisms."
url="https://github.com/eProsima/Fast-CDR"
arch="all"
license="Apache-2.0"
depends_dev="libc++-dev"
makedepends="
    $depends_dev
    cmake
    ninja
    gtest-dev
"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/eProsima/Fast-CDR/archive/refs/tags/v$pkgver.tar.gz
        0001-add-qnx-build.patch
        "
builddir="$srcdir/Fast-CDR-$pkgver"

build() {
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_DATADIR=/usr/lib \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  test_exclude="cmake.force_standard.positive.builtin|cmake.force_standard.positive.manual"
  ctest --test-dir build -E $test_exclude
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}

