pkgname=python3-versioneer
pkgver=0.29
pkgrel=0
pkgdesc="Version-string management for VCS-controlled trees"
url="https://github.com/python-versioneer/python-versioneer"
arch="noarch"
license="Unlicense"
makedepends="
    python3-setuptools
    python3-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/python-versioneer/python-versioneer/archive/refs/tags/$pkgver.tar.gz"
options="!check"
builddir="$srcdir/python-versioneer-$pkgver"

build() {
  python3 setup.py build
}

package() {
  python3 setup.py install --skip-build --root="$pkgdir"
}

