license="BSL-1.0"
subpackages="$pkgname-dev"

builddir="$startdir/asio"

build() { :; }
check() { :; }

package() {
    mkdir -p "$pkgdir/usr/include"
    cp -a "$builddir/include/"* "$pkgdir/usr/include/"
}